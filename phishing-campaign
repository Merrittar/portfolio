<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Anatomy of a Phishing Campaign — Lea Merritt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#080B10;
  --bg-alt:#0D121A;
  --panel:#121822;
  --panel-2:#181F2B;
  --panel-3:#1E2733;
  --line:rgba(255,255,255,0.08);
  --line-strong:rgba(255,255,255,0.14);
  --cyan:#4FE0D0;
  --cyan-dim:rgba(79,224,208,0.14);
  --blue:#6E9CF0;
  --blue-dim:rgba(110,156,240,0.14);
  --violet:#9B8CF0;
  --violet-dim:rgba(155,140,240,0.14);
  --text:#EEF2F7;
  --text-dim:#95A2B5;
  --text-faint:#5A6779;
  --radius:14px;
  --maxw:1180px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto;}
  *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Inter',sans-serif;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img,svg{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
ul{list-style:none;}
.wrap{max-width:var(--maxw); margin:0 auto; padding:0 32px;}
.mono{font-family:'JetBrains Mono',monospace;}
.display{font-family:'Space Grotesk',sans-serif;}

.grid-texture{
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
  background-size:44px 44px;
}

.eyebrow{
  font-family:'JetBrains Mono',monospace;
  font-size:12.5px;
  letter-spacing:0.14em;
  text-transform:uppercase;
  color:var(--cyan);
  display:flex;
  align-items:center;
  gap:10px;
}
.eyebrow::before{
  content:"";
  width:22px;
  height:1px;
  background:linear-gradient(90deg, var(--cyan), transparent);
}

/* ---------- NAV ---------- */
header{
  position:fixed; top:0; left:0; right:0; z-index:100;
  padding:18px 0;
  transition:background .3s ease, border-color .3s ease, padding .3s ease;
  border-bottom:1px solid transparent;
}
header.scrolled{
  background:rgba(8,11,16,0.78);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line);
  padding:14px 0;
}
nav{display:flex; align-items:center; justify-content:space-between;}
.logo{
  width:40px; height:40px; border-radius:10px;
  background:linear-gradient(145deg, var(--panel-2), var(--panel));
  border:1px solid var(--line-strong);
  display:flex; align-items:center; justify-content:center;
  font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:14px;
  color:var(--cyan);
  box-shadow:0 0 0 1px rgba(79,224,208,0.05), 0 6px 18px -8px rgba(0,0,0,0.6);
}
.nav-links{display:flex; gap:34px; align-items:center;}
.nav-links a{
  font-size:14px; color:var(--text-dim); font-weight:500;
  transition:color .2s ease; position:relative;
}
.nav-links a:hover{color:var(--text);}
.nav-cta{
  font-family:'JetBrains Mono',monospace; font-size:12.5px;
  padding:9px 18px; border-radius:9px;
  border:1px solid var(--line-strong);
  background:var(--panel-2);
  color:var(--text) !important;
  transition:all .2s ease;
}
.nav-cta:hover{border-color:var(--cyan); box-shadow:0 0 0 1px var(--cyan), 0 0 24px -4px var(--cyan);}
.menu-btn{display:none; background:none; border:none; color:var(--text); font-size:22px; cursor:pointer;}

@media (max-width:860px){
  .nav-links{
    position:fixed; top:0; right:-100%; height:100vh; width:78%; max-width:340px;
    background:var(--bg-alt); flex-direction:column; justify-content:center; align-items:flex-start;
    padding:40px; gap:26px; transition:right .35s ease; border-left:1px solid var(--line);
    z-index:200;
  }
  .nav-links.open{right:0;}
  .menu-btn{display:block; z-index:210;}
}

/* ---------- HERO ---------- */
.hero{
  position:relative;
  min-height:100vh;
  display:flex; align-items:center;
  padding:150px 0 90px;
  overflow:hidden;
}
.hero::before{
  content:"";
  position:absolute; inset:0;
  background:
    radial-gradient(ellipse 900px 500px at 15% 15%, rgba(79,224,208,0.10), transparent 60%),
    radial-gradient(ellipse 700px 500px at 90% 70%, rgba(110,156,240,0.09), transparent 60%);
  pointer-events:none;
}
#net-canvas{position:absolute; inset:0; width:100%; height:100%; opacity:0.55;}
.hero-inner{position:relative; z-index:2; display:grid; grid-template-columns:1.5fr 1fr; gap:60px; align-items:end;}
.hero-tag{margin-bottom:22px;}
.hero h1{
  font-size:clamp(52px, 8vw, 96px);
  line-height:0.98;
  font-weight:700;
  letter-spacing:-0.02em;
  background:linear-gradient(180deg, #FFFFFF 30%, #AEBBCB 100%);
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.hero-sub{
  margin-top:22px; font-size:clamp(17px,2.2vw,21px); color:var(--text-dim);
  max-width:480px; font-weight:400;
}
.hero-body{margin-top:24px; max-width:520px; color:var(--text-dim); font-size:15.5px;}
.hero-actions{display:flex; gap:14px; margin-top:38px; flex-wrap:wrap;}
.btn{
  font-family:'JetBrains Mono',monospace; font-size:13px; letter-spacing:0.02em;
  padding:15px 26px; border-radius:10px; display:inline-flex; align-items:center; gap:10px;
  transition:all .25s cubic-bezier(.2,.8,.2,1); cursor:pointer; border:1px solid transparent;
}
.btn-primary{
  background:linear-gradient(180deg, rgba(79,224,208,0.18), rgba(79,224,208,0.06));
  border:1px solid rgba(79,224,208,0.4); color:var(--cyan);
}
.btn-primary:hover{transform:translateY(-2px); box-shadow:0 14px 30px -12px rgba(79,224,208,0.35); border-color:var(--cyan);}
.btn-ghost{border:1px solid var(--line-strong); color:var(--text); background:rgba(255,255,255,0.02);}
.btn-ghost:hover{transform:translateY(-2px); border-color:var(--text-dim); background:var(--panel-2);}

.hero-stats{
  display:flex; flex-direction:column; gap:22px;
  border-left:1px solid var(--line); padding-left:28px;
}
.hero-stats li{font-family:'JetBrains Mono',monospace; font-size:13.5px; color:var(--text-dim);}
.hero-stats b{color:var(--cyan); font-weight:500;}
.hero-stats li:nth-child(2) b{color:var(--blue);}
.hero-stats li:nth-child(3) b{color:var(--violet);}

/* ---------- SECTION SHELL ---------- */
section{padding:120px 0; position:relative;}
.section-head{margin-bottom:56px; max-width:640px;}
.section-head h2{
  font-family:'Space Grotesk',sans-serif; font-weight:600;
  font-size:clamp(30px,4vw,46px); margin-top:16px; letter-spacing:-0.01em;
}
.divider{
  display:flex; align-items:center; gap:14px; margin:0 auto 0;
  max-width:var(--maxw); padding:0 32px;
}
.divider::before,.divider::after{content:""; flex:1; height:1px; background:linear-gradient(90deg, transparent, var(--line), transparent);}
.divider-node{width:7px; height:7px; border-radius:2px; background:var(--cyan); transform:rotate(45deg); box-shadow:0 0 12px var(--cyan);}

/* reveal */
.reveal{opacity:0; transform:translateY(28px); transition:opacity .7s ease, transform .7s ease;}
.reveal.in{opacity:1; transform:translateY(0);}

/* ---------- FOCUS GRID ---------- */
.focus-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:18px;}
@media (max-width:980px){.focus-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:560px){.focus-grid{grid-template-columns:1fr;}}
.focus-card{
  background:linear-gradient(160deg, var(--panel-2), var(--panel));
  border:1px solid var(--line); border-radius:var(--radius);
  padding:26px 22px; transition:all .3s ease; position:relative; overflow:hidden;
}
.focus-card::after{
  content:""; position:absolute; inset:0; border-radius:var(--radius);
  padding:1px; background:linear-gradient(135deg, var(--cyan), transparent 40%);
  -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite:xor; mask-composite:exclude;
  opacity:0; transition:opacity .3s ease;
}
.focus-card:hover{transform:translateY(-5px); box-shadow:0 20px 40px -20px rgba(0,0,0,0.6);}
.focus-card:hover::after{opacity:1;}
.focus-icon{
  width:42px; height:42px; border-radius:10px; margin-bottom:18px;
  background:var(--cyan-dim); display:flex; align-items:center; justify-content:center;
  color:var(--cyan);
}
.focus-card h3{font-size:15.5px; font-weight:600; margin-bottom:8px; font-family:'Space Grotesk',sans-serif;}
.focus-card p{font-size:13.5px; color:var(--text-dim); line-height:1.55;}

/* ---------- PROJECTS ---------- */
.proj-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:26px;}
@media (max-width:980px){.proj-grid{grid-template-columns:1fr;}}
.proj-card{
  border-radius:18px; overflow:hidden; background:var(--panel);
  border:1px solid var(--line); position:relative;
  transition:transform .15s ease, box-shadow .3s ease, border-color .3s ease;
  transform-style:preserve-3d; perspective:800px;
  display:block; cursor:pointer;
}
.proj-link{
  display:inline-flex; align-items:center; gap:6px; margin-top:16px;
  font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--cyan);
  opacity:0; transform:translateX(-4px); transition:all .25s ease;
}
.proj-card:hover .proj-link{opacity:1; transform:translateX(0);}
.proj-card:hover{box-shadow:0 30px 60px -25px rgba(0,0,0,0.7); border-color:var(--line-strong);}
.proj-media{height:190px; position:relative; overflow:hidden;}
.proj-media svg{width:100%; height:100%; display:block;}
.proj-media::after{content:""; position:absolute; inset:0; background:linear-gradient(180deg, transparent 40%, rgba(9,12,17,0.9) 100%);}
.proj-tag{
  position:absolute; top:16px; left:16px; z-index:2;
  font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.06em;
  padding:6px 11px; border-radius:20px; backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,0.18); background:rgba(10,14,20,0.45);
}
.proj-year{
  position:absolute; top:16px; right:16px; z-index:2;
  font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--text-dim);
}
.proj-body{padding:24px 24px 28px;}
.proj-body h3{font-family:'Space Grotesk',sans-serif; font-size:19px; font-weight:600; margin-bottom:10px;}
.proj-body p{font-size:13.8px; color:var(--text-dim); line-height:1.6;}
.proj-cat{font-size:11.5px;}

/* ---------- ABOUT ---------- */
.about-grid{display:grid; grid-template-columns:0.9fr 1.1fr; gap:70px; align-items:start;}
@media (max-width:900px){.about-grid{grid-template-columns:1fr; gap:44px;}}
.about-big{font-family:'Space Grotesk',sans-serif; font-size:clamp(36px,5vw,58px); font-weight:600; line-height:1.05; letter-spacing:-0.01em;}
.about-block{margin-bottom:34px;}
.about-block h4{
  font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.1em; text-transform:uppercase;
  color:var(--blue); margin-bottom:12px;
}
.about-block p{color:var(--text-dim); font-size:15px; line-height:1.75;}

/* ---------- TIMELINE ---------- */
.timeline{position:relative; padding-left:34px;}
.timeline::before{content:""; position:absolute; left:6px; top:6px; bottom:6px; width:1px; background:linear-gradient(180deg, var(--cyan), var(--line) 90%);}
.t-item{position:relative; padding-bottom:44px;}
.t-item:last-child{padding-bottom:0;}
.t-item::before{
  content:""; position:absolute; left:-34px; top:4px; width:13px; height:13px; border-radius:50%;
  background:var(--bg); border:2px solid var(--cyan); box-shadow:0 0 0 4px var(--bg), 0 0 16px rgba(79,224,208,0.5);
}
.t-date{font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--cyan); margin-bottom:6px; display:block;}
.t-item h3{font-family:'Space Grotesk',sans-serif; font-size:18px; font-weight:600; margin-bottom:3px;}
.t-item .t-org{font-size:13.5px; color:var(--text-dim); margin-bottom:10px;}
.t-item p{font-size:14px; color:var(--text-dim); line-height:1.65; max-width:640px;}
.chip-row{display:flex; flex-wrap:wrap; gap:8px; margin-top:12px;}
.chip{
  font-family:'JetBrains Mono',monospace; font-size:11px; padding:5px 11px; border-radius:20px;
  border:1px solid var(--line); color:var(--text-dim); background:rgba(255,255,255,0.02);
}

.exp-sub{margin-top:18px; padding-left:20px; border-left:1px solid var(--line);}
.exp-sub .t-item{padding-bottom:30px;}
.exp-sub .t-item::before{left:-27px; width:9px; height:9px; border-color:var(--blue); box-shadow:0 0 0 4px var(--bg), 0 0 12px rgba(110,156,240,0.5);}
.exp-sub .t-date{color:var(--blue);}

.two-col-tl{display:grid; grid-template-columns:1fr 1fr; gap:70px;}
@media (max-width:900px){.two-col-tl{grid-template-columns:1fr; gap:50px;}}
.col-label{font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-faint); margin-bottom:30px;}

/* ---------- AWARDS ---------- */
.award-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
@media (max-width:980px){.award-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:560px){.award-grid{grid-template-columns:1fr;}}
.award-card{
  background:linear-gradient(160deg, var(--panel-2), var(--panel));
  border:1px solid var(--line); border-radius:var(--radius); padding:28px 22px;
  text-align:center; transition:transform .3s ease, border-color .3s ease;
}
.award-card:hover{transform:translateY(-4px); border-color:rgba(155,140,240,0.4);}
.award-icon{color:var(--violet); margin:0 auto 16px;}
.award-org{font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.06em; color:var(--violet); text-transform:uppercase; margin-bottom:8px;}
.award-card h3{font-size:15px; font-weight:600; margin-bottom:12px; font-family:'Space Grotesk',sans-serif;}
.award-card p{font-size:12.5px; color:var(--text-dim); line-height:1.6;}

/* ---------- TESTIMONIALS ---------- */
.test-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:22px;}
@media (max-width:820px){.test-grid{grid-template-columns:1fr;}}
.test-card{
  background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:30px;
  position:relative;
}
.test-quote-mark{position:absolute; top:20px; right:26px; font-family:'Space Grotesk',sans-serif; font-size:56px; color:var(--panel-3); line-height:1;}
.test-head{display:flex; align-items:center; gap:14px; margin-bottom:18px;}
.avatar{
  width:46px; height:46px; border-radius:50%; flex-shrink:0;
  background:linear-gradient(135deg, var(--cyan-dim), var(--blue-dim));
  border:1px solid var(--line-strong);
  display:flex; align-items:center; justify-content:center;
  font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:14px; color:var(--text);
}
.test-head h4{font-size:14.5px; font-weight:600;}
.test-head span{font-size:12px; color:var(--text-dim); display:block; margin-top:2px;}
.test-card p{font-size:14px; color:var(--text-dim); line-height:1.7; position:relative; z-index:1;}

/* ---------- VOLUNTEER ---------- */
.vol-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
@media (max-width:900px){.vol-grid{grid-template-columns:1fr;}}
.vol-card{border-radius:var(--radius); overflow:hidden; border:1px solid var(--line); background:var(--panel);}
.vol-media{height:150px; position:relative;}
.vol-media svg{width:100%; height:100%;}
.vol-body{padding:22px;}
.vol-body .t-date{font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--cyan); text-transform:uppercase; letter-spacing:0.06em;}
.vol-body h3{font-family:'Space Grotesk',sans-serif; font-size:16.5px; font-weight:600; margin:8px 0 10px;}
.vol-body p{font-size:13px; color:var(--text-dim); line-height:1.6;}

/* ---------- CONTACT ---------- */
.contact-panel{
  border-radius:24px; padding:70px 60px; position:relative; overflow:hidden;
  background:linear-gradient(160deg, var(--panel-2), var(--bg-alt));
  border:1px solid var(--line-strong);
}
.contact-panel::before{
  content:""; position:absolute; inset:0;
  background:radial-gradient(ellipse 600px 300px at 85% 0%, rgba(79,224,208,0.14), transparent 70%);
}
.contact-grid{position:relative; z-index:1; display:flex; justify-content:space-between; align-items:flex-end; gap:40px; flex-wrap:wrap;}
.contact-grid h2{font-family:'Space Grotesk',sans-serif; font-size:clamp(34px,5vw,54px); font-weight:600; letter-spacing:-0.01em; max-width:480px;}
.contact-list{display:flex; flex-direction:column; gap:14px;}
.contact-list a{
  display:flex; align-items:center; gap:12px; font-family:'JetBrains Mono',monospace; font-size:14px;
  padding:13px 18px; border-radius:10px; border:1px solid var(--line-strong); background:rgba(255,255,255,0.02);
  transition:all .25s ease;
}
.contact-list a:hover{border-color:var(--cyan); color:var(--cyan); transform:translateX(4px);}

footer{padding:40px 0; border-top:1px solid var(--line);}
.foot-row{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;}
.foot-row p{font-size:12.5px; color:var(--text-faint); font-family:'JetBrains Mono',monospace;}

@media (max-width:900px){
  .hero-inner{grid-template-columns:1fr;}
  .hero-stats{border-left:none; padding-left:0; border-top:1px solid var(--line); padding-top:24px; margin-top:10px;}
  section{padding:80px 0;}
  .wrap{padding:0 22px;}
  .contact-panel{padding:44px 26px;}
  .contact-grid{align-items:flex-start;}
}


/* case-study components */
/* Shared case-study components — default site theme (cyan/blue/violet, Space Grotesk + JetBrains Mono) */

.cs-hero{min-height:auto; padding:150px 0 70px; align-items:flex-start;}
.cs-hero::before{background:radial-gradient(ellipse 900px 500px at 15% 0%, rgba(79,224,208,0.10), transparent 60%);}
.back-link{
  display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace;
  font-size:12.5px; color:var(--text-dim); margin-bottom:28px; transition:color .2s ease;
}
.back-link:hover{color:var(--cyan);}
.cs-title{font-size:clamp(38px,6vw,64px); font-weight:700; letter-spacing:-0.02em; max-width:820px;
  background:linear-gradient(180deg,#fff 30%,#AEBBCB 100%); -webkit-background-clip:text; background-clip:text; color:transparent;}
.cs-meta{display:flex; gap:40px; flex-wrap:wrap; margin-top:34px; padding-top:28px; border-top:1px solid var(--line);}
.cs-meta div h4{font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--text-faint); margin-bottom:6px;}
.cs-meta div p{font-size:14.5px; font-weight:500;}
.cs-lede{font-size:17px; color:var(--text-dim); max-width:720px; margin-top:26px; line-height:1.75;}

.stat-row{display:grid; grid-template-columns:repeat(4,1fr); gap:18px;}
@media (max-width:820px){.stat-row{grid-template-columns:repeat(2,1fr);}}
.stat-card{background:linear-gradient(160deg, var(--panel-2), var(--panel)); border:1px solid var(--line); border-radius:var(--radius); padding:24px;}
.stat-card .num{font-family:'Space Grotesk',sans-serif; font-size:34px; font-weight:700; color:var(--cyan);}
.stat-card .lbl{font-size:12.5px; color:var(--text-dim); margin-top:6px; line-height:1.4;}

.body-copy{max-width:760px;}
.body-copy p{color:var(--text-dim); font-size:15.5px; line-height:1.8; margin-bottom:20px;}
.body-copy h3{font-family:'Space Grotesk',sans-serif; font-size:22px; font-weight:600; margin:8px 0 16px; color:var(--text);}
.pull-quote{
  border-left:2px solid var(--cyan); padding:6px 0 6px 24px; margin:36px 0;
  font-family:'Space Grotesk',sans-serif; font-size:21px; font-weight:500; color:var(--text); max-width:640px;
}

.persona-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:14px;}
@media (max-width:980px){.persona-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:560px){.persona-grid{grid-template-columns:1fr;}}
.persona-card{background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:20px;}
.persona-card .p-num{font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--cyan); margin-bottom:10px;}
.persona-card .p-age{font-family:'Space Grotesk',sans-serif; font-size:20px; font-weight:600;}
.persona-card ul{margin-top:12px; display:flex; flex-direction:column; gap:6px;}
